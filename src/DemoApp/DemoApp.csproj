<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Framework-dependent, deliberately, and NOT negotiable.
         The eBPF profiler locates the .NET runtime by path regex
         /(\d+)\.(\d+).(\d+)/libcoreclr.so$ — self-contained and single-file
         layouts do not put it there, and NativeAOT is explicitly unsupported.
         Publishing "more efficiently" would silently blind the profiler while
         the app carried on working. -->
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>

    <!-- Keep frames attributable. Tiered PGO can inline aggressively at tier 1,
         and an inlined frame is invisible to eBPF (#7). The hot paths below also
         carry [MethodImpl(NoInlining)] — belt and braces, because a flame graph
         that mysteriously flattens is very hard to diagnose after the fact. -->
    <TieredPGO>false</TieredPGO>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.10.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.10.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.10.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.10.0" />
  </ItemGroup>

</Project>
