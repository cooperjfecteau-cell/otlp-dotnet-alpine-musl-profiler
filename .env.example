# Copy to .env and fill in. .env is gitignored -- never commit real values.
#
# NOTE: Dynatrace has two independent auth systems here, and they do not overlap.
# Ingest uses a classic API token ("Api-Token dt0c01..."). Bucket management uses a
# platform token ("Bearer ..."). Only the API token needs to live in this file --
# see the bucket section below for why.

# --- Dynatrace ---------------------------------------------------------------
# Two hosts, not interchangeable. Verified against the tenant:
#   .live  -> API v2 ingest (/api/v2/otlp/v1/*, /api/v2/events/ingest). The .apps host
#             404s on these paths.
#   .apps  -> platform: Strato app, dtctl, storage management, DQL.
DT_ENDPOINT=https://YOUR-TENANT.live.dynatrace.com
DT_PLATFORM_URL=https://YOUR-TENANT.apps.dynatrace.com

# VERIFIED: the OTLP endpoint is PROTOBUF-ONLY. application/json returns 415 even with a
# valid OTLP payload; application/x-protobuf is accepted. Do NOT hand-roll JSON POSTs to
# /api/v2/otlp/v1/logs -- that is what the PoC did and it cannot work here. Export through
# the OTel Collector's otlphttp exporter, which emits protobuf natively.

# Classic API token. This is the only secret the running system needs.
#
# Settings > Access tokens > Generate new token. Required scopes:
#
#   openTelemetryTrace.ingest   OTLP export to /api/v2/otlp/v1/*
#   logs.ingest                 profile records land as logs
#   events.ingest               problem annotation + service custom event
#
# That is the complete runtime set. The broker needs exactly one of these
# (events.ingest); the collector needs the other two.
DT_API_TOKEN=dt0c01.CHANGEME

# --- Grail bucket ------------------------------------------------------------
# Dedicated bucket, 7-day retention. Profile data bills as logs and is worthless
# after the investigation. Deliberately NOT "Retain with Included Queries" -- that
# carries a 10-day minimum and costs 28.6x on storage, and this workload is
# write-heavy / read-light, so paying 28.6x to make the cheap half free is a bad trade.
DT_PROFILE_BUCKET=profiling_dotnet_7d

# Bucket creation needs a PLATFORM token (Bearer), not the API token above, with:
#   storage:buckets:write        <- this is the one dtctl actually requires
#   storage:bucket-definitions:read
#
# WARNING, verified the hard way: having the scope is NOT sufficient. OAuth scopes are what
# a token MAY REQUEST; the IAM policy bound to your user or group is what you are PERMITTED
# to do. `dtctl ... --check-scopes` inspects only the former, so it reports ok and the API
# still returns 403 "Required permissions not met". Grant the bucket-creation policy in
# Account Management > Policies first. See issue #29.
#
# You do not need to mint or store one. It is a one-time setup step, and dtctl
# already handles the OAuth flow interactively:
#
#   dtctl auth login --context fal --environment https://YOUR-TENANT.apps.dynatrace.com
#   dtctl create bucket --name profiling_dotnet_7d --table logs --retention 7 --check-scopes
#   dtctl create bucket --name profiling_dotnet_7d --table logs --retention 7
#
# Keeping this out of .env means the long-lived secret in the repo's runtime path
# cannot create or delete storage.

# --- AWS / cluster -----------------------------------------------------------
AWS_REGION=us-east-1
EKS_CLUSTER_NAME=YOUR-CLUSTER

# --- Profiling ---------------------------------------------------------------
PROFILE_DURATION_SECONDS=90
PROFILE_SAMPLE_HZ=99

# Charged against the PROFILED APPLICATION's memory limit, not the sidecar's.
# Too high and profiling OOMKills the workload it is observing. 128 is a starting
# guess pending measurement -- see the "Sampling overhead" gap on the map.
PROFILE_BUFFER_SIZE_MB=128
