# Copy to .env and fill in. .env is gitignored -- never commit real values.

# --- Dynatrace ---------------------------------------------------------------
DT_ENDPOINT=https://YOUR-TENANT.apps.dynatrace.com

# Platform token. Required scopes:
#   openTelemetryTrace.ingest   OTLP export
#   logs.ingest                 profile records land as logs
#   events.ingest               Davis event on the problem, custom event on the service
#   storage:bucket-definitions:write   dedicated short-retention profile bucket
#   storage:logs:read           the viewer's DQL
DT_API_TOKEN=dt0c01.CHANGEME

# Dedicated Grail bucket for profile records. 7-day retention -- profile data is
# billed as logs and is worthless after the investigation.
DT_PROFILE_BUCKET=profiles

# --- AWS / cluster -----------------------------------------------------------
AWS_REGION=us-east-1
EKS_CLUSTER_NAME=eks-arm-new

# --- Profiling ---------------------------------------------------------------
PROFILE_DURATION_SECONDS=90
PROFILE_SAMPLE_HZ=99
